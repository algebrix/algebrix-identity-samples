# Your organization's issuer value, exactly as shown in the console integration view.
ALGEBRIX_ISSUER=https://auth.algebrix.co/realms/your-organization
# From your server-side web application in the console.
ALGEBRIX_CLIENT_ID=your-client-id
ALGEBRIX_CLIENT_SECRET=your-client-secret
# Must match the addresses registered on the application exactly.
ALGEBRIX_REDIRECT_URI=http://localhost:3001/callback
ALGEBRIX_POST_LOGOUT_REDIRECT_URI=http://localhost:3001/
# Any long random string. Generate your own, for example: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string
