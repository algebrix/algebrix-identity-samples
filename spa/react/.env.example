# Vite exposes only keys that start with VITE_ to the browser code. Never put a secret here.
# Your organization's issuer value, exactly as shown in the console integration view.
VITE_ALGEBRIX_ISSUER=https://auth.algebrix.co/realms/your-organization
# From your single-page app in the console. Single-page apps have no secret.
VITE_ALGEBRIX_CLIENT_ID=your-client-id
# Both must be registered as sign-in redirect URIs on the application.
VITE_ALGEBRIX_REDIRECT_URI=http://localhost:3000/callback
VITE_ALGEBRIX_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/
